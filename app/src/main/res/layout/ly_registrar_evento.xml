<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_crema">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarRegistrarEvento"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/color_navegacion_claro"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:title="Registrar Evento"
        app:titleTextColor="@color/blanco" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/btn_guardar_evento"
        app:layout_constraintTop_toBottomOf="@id/toolbarRegistrarEvento">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre del Evento"
                android:textColor="@color/marronOscuro"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edt_nombre_evento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ej. Gran Feria de Adopción"
                android:inputType="textCapSentences"
                android:minHeight="48dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Fecha y Hora"
                android:textColor="@color/marronOscuro"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edt_fecha_evento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ej. 25 de Octubre, 2023 - 10:00 AM"
                android:inputType="text"
                android:minHeight="48dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Descripción"
                android:textColor="@color/marronOscuro"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edt_descripcion_evento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:hint="Cuéntanos más sobre el evento..."
                android:inputType="textMultiLine"
                android:minHeight="120dp"
                android:lines="5" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Foto (URL)"
                android:textColor="@color/marronOscuro"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edt_foto_evento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="https://ejemplo.com/foto.jpg"
                android:inputType="textUri"
                android:minHeight="48dp" />

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btn_guardar_evento"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:backgroundTint="@color/marronPrimario"
        android:text="GUARDAR EVENTO"
        android:textColor="@color/blanco"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>